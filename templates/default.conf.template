server {
    listen 80;
    server_name _;
    client_max_body_size 100m;

    # Health checks of tunnel connectors (e.g. Pangolin's connector polls GET / and
    # requires 2xx). Without this the target is marked unhealthy and you get 503.
    location = / { default_type text/plain; return 200 "ok\n"; }

    # Only the secret prefix is proxied upstream; everything else is a hard 404.
    location = /${SECRET_PREFIX} { return 301 /${SECRET_PREFIX}/$is_args$args; }
    location /${SECRET_PREFIX}/ {
        # 127.0.0.11 — docker's embedded DNS (fast, always available in the
        # container); public resolvers as fallback. ipv6=off: containers
        # usually have no IPv6 route, and an AAAA-only answer would fail
        # with "network unreachable".
        resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        resolver_timeout 5s;

        # NOTE: `set` must come BEFORE `rewrite ... break`,
        # otherwise the variable is not initialized and nginx 500s.
        set $upstream ${UPSTREAM_URL};

        # Strip the secret prefix, forward the rest of the path as-is.
        rewrite ^/${SECRET_PREFIX}/(.*)$ /$1 break;
        proxy_pass $upstream;

        # SNI and Host must point at the upstream, or its edge returns 403/404.
        proxy_ssl_server_name on;
        proxy_ssl_name ${UPSTREAM_HOST};
        proxy_set_header Host ${UPSTREAM_HOST};

        # SSE streaming without buffering; long timeouts for LLM answers.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
    }

    # Everything outside the secret prefix — 404.
    location / { return 404; }
}
