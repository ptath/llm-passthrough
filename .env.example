# Path prefix — the only gate in front of your proxy.
# install.sh generates a random 32-char value on first run.
# You can override it here. It becomes part of your URLs:
#   https://your.domain/<SECRET_PREFIX>/api/v1/...
SECRET_PREFIX=CHANGE_ME_OR_RUN_INSTALL_SH

# Optional: forward to a different API. Defaults below are OpenRouter.
# For OpenAI, for example:  UPSTREAM_URL=https://api.openai.com  UPSTREAM_HOST=api.openai.com
#UPSTREAM_URL=https://openrouter.ai
#UPSTREAM_HOST=openrouter.ai

# Bind for the debug listener (defaults below). For a reverse proxy on
# ANOTHER machine set BIND_IP=0.0.0.0 and open BIND_PORT to it.
#BIND_IP=127.0.0.1
#BIND_PORT=8080
